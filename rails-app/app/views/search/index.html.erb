<div id="app" class="container">
  <h1>作品検索 / Story Search</h1>
  
  <div>
    <input 
      type="text" 
      v-model="searchQuery" 
      placeholder="検索キーワードを入力してください / Enter search keywords..."
      class="search-box"
    />
  </div>

  <div class="results-area">
    <div v-if="loading" class="loading">
      検索中です... / Searching...
    </div>
    
    <div v-else-if="error" class="error">
      エラー / Error: {{ error }}
    </div>
    
    <div v-else-if="results.length === 0 && hasSearched" class="no-results">
      検索結果が見つかりませんでした / No results found
    </div>
    
    <div v-else-if="results.length > 0">
      <div style="margin-bottom: 15px; color: #666;">
        {{ totalResults }}件の結果が見つかりました / Found {{ totalResults }} results
      </div>
      
      <div v-for="result in results" :key="result.id" class="result-item">
        <div class="result-text">{{ result.text }}</div>
        <div class="result-meta">行番号 / Line: {{ result.line_number }}</div>
      </div>
    </div>
    
    <div v-else style="text-align: center; color: #999; padding: 20px;">
      検索キーワードを入力すると自動で検索されます<br>
      Search results will appear automatically as you type
    </div>
  </div>
</div>

<script>
const { createApp } = Vue;

createApp({
  data() {
    return {
      searchQuery: '',
      results: [],
      totalResults: 0,
      loading: false,
      error: null,
      hasSearched: false,
      searchTimeout: null
    }
  },
  watch: {
    searchQuery(newQuery) {
      if (this.searchTimeout) {
        clearTimeout(this.searchTimeout);
      }
      
      if (!newQuery.trim()) {
        this.results = [];
        this.totalResults = 0;
        this.error = null;
        this.hasSearched = false;
        return;
      }
      
      this.searchTimeout = setTimeout(() => {
        this.performSearch();
      }, 300);
    }
  },
  methods: {
    async performSearch() {
      if (!this.searchQuery.trim()) {
        return;
      }

      this.loading = true;
      this.error = null;
      this.hasSearched = true;

      try {
        const response = await axios.post('/search', {
          query: this.searchQuery
        });

        this.results = response.data.results || [];
        this.totalResults = response.data.total || 0;
        
        if (response.data.error) {
          this.error = response.data.message || response.data.error;
        }
      } catch (error) {
        this.error = 'サーバーエラーが発生しました / Server error occurred';
        console.error('Search error:', error);
      } finally {
        this.loading = false;
      }
    }
  }
}).mount('#app');
</script>
